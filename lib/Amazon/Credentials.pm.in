package Amazon::Credentials;

# - module for finding and providing AWS credentials

use strict;
use warnings;

use 5.010;

use parent qw( Exporter Class::Accessor::Fast );

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    cache
    debug
    error
    print_error
    raise_error
    imdsv2
    logger
    order
    plugins
    profile
    provider
    region
    source
    timeout
    user_agent
    sso_account_id
    sso_region
    sso_role_name
  )
);

use Amazon::Credentials::HTTP::UserAgent;
use Amazon::Credentials::HTTP::Response;
use Amazon::Credentials::Utils qw(choose);

use Carp;
use Data::Dumper;
use English qw(-no_match_vars);
use JSON;
use List::Util qw(any);
use Scalar::Util qw(reftype blessed);
use Time::Local qw(timegm_modern);

use constant { ## no critic (ProhibitConstantPragma, Capitalization)
  DEFAULT_TIMEOUT         => 3,
  DEFAULT_WINDOW_INTERVAL => 5,
  SECONDS_IN_MINUTE       => 60,
  ISO8601_FORMAT          => q{%Y-%m-%dT%H:%M:%S%z},
  EMPTY                   => q{},
  LOG_FORMAT              => qq{ %s [%s] %s\n },
  SUCCESS                 => 0,
  FALSE                   => 0,
  TRUE                    => 1,
};

our $VERSION = '@PACKAGE_VERSION@'; ## no critic (RequireInterpolation)

my %PROVIDERS;

my %PROVIDER_ALIASES = (
  profile       => 'file',
  instance_role => 'role',
);

our @EXPORT_OK = qw(
  get_role_credentials
  normalize_arn
  set_sso_credentials
);

# we only log at debug level, create a default logger
{
  no strict 'refs'; ## no critic (ProhibitNoStrict)

  *{'Amazon::Credentials::Logger::debug'} = sub {
    my ( $self, @message ) = @_;

    return if !$self->{debug};

    my $timestamp = scalar localtime;
    foreach my $message (@message) {
      if ( ref $message eq 'CODE' ) {
        $message = $message->();
      }
    }

    my $message = sprintf LOG_FORMAT, $timestamp, $PROCESS_ID, @message;

    print {*STDERR} $message;
  };
}

caller or __PACKAGE__->main();

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? $args[0] : {@args};

  my $self = $class->SUPER::new($options);

  $self->_set_defaults;

  $self->_init_logger;

  $self->_init_credentials($options);

  return $self
    if $options->{aws_access_key_id}
    && $options->{aws_secret_access_key};

  if ( $self->get_sso_role_name && $self->get_sso_account_id ) {

    require Amazon::Credentials::Provider::SSO;

    my $provider = Amazon::Credentials::Provider::SSO->new(
      sso_role_name  => $self->get_sso_role_name,
      sso_account_id => $self->get_sso_account_id,
      sso_region     => $self->get_sso_region,
      region         => $self->get_region,
      user_agent     => $self->get_user_agent,
    );

    croak 'could not resolve SSO credentials'
      if !$provider;

    $self->set_provider($provider);
    $self->set_credentials( $provider->credentials );

    $self->set_region( $provider->get_region )
      if defined $provider->get_region;

    $self->set_source( $provider->get_source )
      if defined $provider->get_source;

    return $self;
  }

  $self->_init_plugins;

  my $result = eval {
    $self->_resolve_credentials;
    return TRUE;
  };

  if ( !$result ) {
    my $error = $EVAL_ERROR;

    $self->set_error($error);

    croak $error
      if $self->get_raise_error;

    carp $error
      if $self->get_print_error;
  }

  return $self;
}

########################################################################
sub register_provider {
########################################################################
  my ( $class, $provider_class ) = @_;

  croak 'provider class is required'
    if !$provider_class;

  croak "invalid provider class '$provider_class'"
    if $provider_class !~ /\A[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*\z/xsm;

  my $module = $provider_class;
  $module =~ s{::}{/}gxsm;
  $module .= '.pm';

  eval { require $module; 1 }
    or croak "could not load provider $provider_class: $EVAL_ERROR";

  my ($name) = $provider_class =~ /([^:]+)\z/xsm;
  $name = _to_snake_case($name);
  $name = $PROVIDER_ALIASES{$name} // $name;

  if ( exists $PROVIDERS{$name} ) {
    croak "provider '$name' is already registered by $PROVIDERS{$name}"
      if $PROVIDERS{$name} ne $provider_class;

    return $class;
  }

  $PROVIDERS{$name} = $provider_class;

  return $class;
}

########################################################################
sub _plugin_order {
########################################################################
  my ($self) = @_;

  my @DEFAULT_ORDER = qw(
    env
    container
    role
    web_identity
    file
  );

  my $order = choose {
    return $self->get_order
      if defined $self->get_order;

    return $self->get_plugins
      if defined $self->get_plugins;

    return ['file']
      if defined $self->get_profile;

    return \@DEFAULT_ORDER;
  };

  $order = [$order]
    if !ref $order;

  croak 'order must be an array reference'
    if reftype($order) ne 'ARRAY';

  my @order;

  foreach my $name ( @{$order} ) {
    $name = $self->_normalize_plugin_name($name);

    croak "unknown credentials plugin '$name'"
      if !exists $PROVIDERS{$name};

    push @order, $name;
  }

  if ( defined $self->get_plugins ) {
    my %enabled = map { $_ => TRUE } @{ $self->get_plugins };

    foreach my $name (@order) {
      croak "credentials plugin '$name' is not enabled"
        if !$enabled{$name};
    }
  }

  return \@order;
}

########################################################################
sub _resolve_credentials {
########################################################################
  my ($self) = @_;

  my $order = $self->_plugin_order;

  my %options = (
    debug      => $self->get_debug,
    logger     => $self->get_logger,
    profile    => $self->get_profile,
    region     => $self->get_region,
    timeout    => $self->get_timeout,
    user_agent => $self->get_user_agent,
    imdsv2     => $self->get_imdsv2,
  );

  foreach my $name ( @{$order} ) {
    my $class = $PROVIDERS{$name};

    croak
      sprintf( "credentials plugin '%s' is not registered; available plugins: %s", $name, join q{, }, sort keys %PROVIDERS, )
      if !$class;

    croak "credentials plugin '$name' is not registered"
      if !$class;

    my $plugin = $class->new( \%options );

    next
      if !$plugin;

    my $provider = $name eq 'file' ? $plugin->resolve( $self->get_profile ) : $plugin;

    next
      if !$provider;

    $self->set_provider($provider);

    my $credentials = $provider->credentials;

    $self->set_credentials($credentials);

    if ( defined $credentials->{region} ) {
      $self->set_region( $credentials->{region} );
    }

    $self->set_source( $credentials->{source} )
      if defined $credentials->{source};

    return $self;
  }

  croak 'no credentials available';
}

########################################################################
sub is_token_expired {
########################################################################
  my ( $self, $window_interval ) = @_;

  $window_interval //= DEFAULT_WINDOW_INTERVAL;

  my $expiration = $self->get_expiration;

  return FALSE
    if !defined $expiration;

  my $expiration_time = _iso8601_to_time($expiration);

  $expiration_time -= $window_interval * SECONDS_IN_MINUTE;

  return $expiration_time < time
    ? TRUE
    : FALSE;
}

########################################################################
sub set_expiration {
########################################################################
  my ( $self, $expiration ) = @_;

  my $provider = $self->get_provider;

  return
    if !$provider;

  $provider->set_expiration($expiration);

  return $self;
}
########################################################################
sub _iso8601_to_time {
########################################################################
  my $iso8601 = shift;

  $iso8601 =~ s/^(.*)Z$/$1\+00:00/xsm;

  require POSIX::strptime;
  POSIX::strptime->import('strptime');

  require Time::Local;
  Time::Local->import('timegm');

  my $gmtime = eval {
    local $ENV{TZ} = 'GMT';

    timegm( strptime( $iso8601, ISO8601_FORMAT ) );
  };

  return $gmtime;
}

########################################################################
sub refresh_token {
########################################################################
  my ($self) = @_;

  my $provider = $self->get_provider;

  croak 'credentials are not refreshable'
    if !$provider || !$provider->is_refreshable;

  $provider->refresh_credentials;

  $self->set_credentials( $provider->credentials );

  return $self;
}

########################################################################
sub get_expiration {
########################################################################
  my ($self) = @_;

  my $provider = $self->get_provider;

  return
    if !$provider;

  return $provider->get_expiration;
}

########################################################################
sub _init_plugins {
########################################################################
  my ($self) = @_;

  foreach my $class (
    qw(
    Amazon::Credentials::Provider::Env
    Amazon::Credentials::Provider::Container
    Amazon::Credentials::Provider::InstanceRole
    Amazon::Credentials::Provider::WebIdentity
    Amazon::Credentials::Resolver::Profile
    )
  ) {
    $self->register_provider($class);
  }

  my $plugins = $self->get_plugins;

  return $self
    if !defined $plugins;

  croak 'plugins must be an array reference'
    if reftype($plugins) ne 'ARRAY';

  my @plugins;

  foreach my $name ( @{$plugins} ) {
    $name = $self->_normalize_plugin_name($name);

    croak "unknown credentials plugin '$name'"
      if !exists $PROVIDERS{$name};

    push @plugins, $name;
  }

  $self->set_plugins( \@plugins );

  return $self;
}

########################################################################
sub _normalize_plugin_name {
########################################################################
  my ( $self, $name ) = @_;

  return $PROVIDER_ALIASES{$name} // $name;
}

########################################################################
sub _to_snake_case {
########################################################################
  my ($str) = @_;

  return q{}
    if !defined $str;

  $str =~ s/([[:upper:]]+)([[:upper:]][[:lower:]])/$1_$2/xsmg;
  $str =~ s/([[:lower:]\d])([[:upper:]])/$1_$2/xsmg;

  return lc $str;
}

# New method replaces _init_encryption, set_aws_access_key_id,
# set_aws_secret_access_key, set_token, and all of _crypt/_fetch_passkey etc.
########################################################################
sub _init_credentials {
########################################################################
  my ( $self, $options ) = @_;
  $options //= {};

  my ( $key_id, $secret, $token ) = @{$options}{qw( aws_access_key_id aws_secret_access_key token )};

  $self->{_access_key_id}     = sub {$key_id};
  $self->{_secret_access_key} = sub {$secret};
  $self->{_session_token}     = sub {$token};

  return;
}

sub get_aws_access_key_id     { return $_[0]->_get_credential('_access_key_id') }
sub get_aws_secret_access_key { return $_[0]->_get_credential('_secret_access_key') }
sub get_token                 { return $_[0]->_get_credential('_session_token') }

########################################################################
sub _get_credential {
########################################################################
  my ( $self, $slot ) = @_;

  my $value = $self->{$slot}->();

  return $value
    if $self->get_cache;

  $self->{$slot} = sub {undef};

  return $value;
}

########################################################################
sub set_aws_access_key_id {
########################################################################
  my ( $self, $val ) = @_;

  $self->{_access_key_id} = sub {$val};

  return;
}

########################################################################
sub set_aws_secret_access_key {
########################################################################
  my ( $self, $val ) = @_;

  $self->{_secret_access_key} = sub {$val};

  return;
}

########################################################################
sub set_token {
########################################################################
  my ( $self, $val ) = @_;

  $self->{_session_token} = sub {$val};
  return;
}

########################################################################
sub set_default_logger {
########################################################################
  my ( $self, $debug ) = @_;

  $debug = $debug // $self->get_debug;

  my $logger = bless { debug => $debug }, 'Amazon::Credentials::Logger';

  $self->set_logger($logger);

  return $self;
}

########################################################################
sub reset_credentials {
########################################################################
  my ($self) = @_;

  $self->_init_credentials;

  return $self;
}

########################################################################
sub set_credentials {
########################################################################
  my ( $self, $creds ) = @_;

  $creds //= {};

  croak 'no credentials available'
    if !$creds->{aws_secret_access_key} || !$creds->{aws_access_key_id};

  $self->set_aws_secret_access_key( $creds->{aws_secret_access_key} );

  $self->set_aws_access_key_id( $creds->{aws_access_key_id} );

  $self->set_token( $creds->{token} || $creds->{aws_session_token} );

  return $self;
}

########################################################################
sub normalize_arn {
########################################################################
  my $arn = ( @_ == 2 ) ? $_[1] : $_[0];

  if ( $arn =~ m{arn:aws:sts::(\d+):assumed-role/([^/]+)/}xsm ) {
    return "arn:aws:iam::$1:role/$2";
  }

  return $arn;
}

########################################################################
sub credential_keys {
########################################################################
  my ($self) = @_;

  my %credential_keys = (
    AWS_ACCESS_KEY_ID     => $self->get_aws_access_key_id,
    AWS_SECRET_ACCESS_KEY => $self->get_aws_secret_access_key,
    AWS_SESSION_TOKEN     => $self->get_token,
  );

  if ( !defined $credential_keys{AWS_SESSION_TOKEN} ) {
    delete $credential_keys{AWS_SESSION_TOKEN};
  }

  return \%credential_keys;
}

########################################################################
sub as_string {
########################################################################
  my ($self) = @_;

  return JSON->new->pretty->encode( $self->credential_keys );
}

########################################################################
sub format_credentials {
########################################################################
  my ( $self, $format ) = @_;

  $format = $format || "%s %s\n";

  my $credential_keys = $self->credential_keys;

  return join EMPTY, map { sprintf $format, $_, $credential_keys->{$_} // EMPTY }
    keys %{$credential_keys};
}

########################################################################
sub set_aws_session_token { goto &set_token; }
sub get_aws_session_token { goto &get_token; }
########################################################################

########################################################################
sub set_sso_credentials {
########################################################################
  my ( $role_name, $account_id, $region ) = @_;

  croak "usage: Amazon::Credentials::set_sso_credentials(role-name, account-id)\n"
    if ref $role_name;

  my $credentials = get_role_credentials(
    role_name  => $role_name,
    account_id => $account_id,
    region     => $region,
  );

  if ($credentials) {
    $ENV{AWS_ACCESS_KEY_ID} = $credentials->{accessKeyId};

    $ENV{AWS_SECRET_ACCESS_KEY} = $credentials->{secretAccessKey};

    $ENV{AWS_SESSION_TOKEN} = $credentials->{sessionToken};
  }

  return $credentials;
}

########################################################################
sub get_role_credentials {
########################################################################
  require Amazon::Credentials::Provider::SSO;

  return Amazon::Credentials::Provider::SSO->get_role_credentials(@_);
}

########################################################################
sub _init_logger {
########################################################################
  my ($self) = @_;

  if ( !$self->get_logger || !ref $self->get_logger ) {
    $self->set_default_logger;
  }

  $self->get_logger->debug( sub { return sprintf 'using %s logger', ref $self->get_logger } );

  return $self;
}

########################################################################
sub _set_defaults {
########################################################################
  my ($self) = @_;

  $self->set_debug( $self->get_debug // FALSE );

  $self->set_cache( defined $self->get_cache ? $self->get_cache : TRUE );

  my $timeout = $self->get_timeout // DEFAULT_TIMEOUT;

  if ( !$self->get_user_agent ) {
    $self->set_user_agent( Amazon::Credentials::HTTP::UserAgent->new( timeout => $timeout ) );
  }

  if ( !$self->get_profile ) {
    $self->set_profile( $ENV{AWS_PROFILE} );
  }

  $self->set_raise_error(
    defined $self->get_raise_error
    ? $self->get_raise_error
    : TRUE
  );

  $self->set_print_error(
    defined $self->get_print_error
    ? $self->get_print_error
    : TRUE
  );

  my $imdsv2 = choose {

    return 'preferred'
      if !defined $self->get_imdsv2;

    return {
      0 => 'disabled',
      1 => 'required',
    }->{ $self->get_imdsv2 }
      if $self->get_imdsv2 =~ /^[01]$/xsm;

    return $self->get_imdsv2
      if any { $_ eq $self->get_imdsv2 } qw(required preferred disabled);

    croak sprintf "invalid imdsv2 mode '%s'", $self->get_imdsv2;
  };

  $self->set_imdsv2($imdsv2);

  return $self;
}

#######################################################################
sub help {
########################################################################
  my ($options) = @_;

  if ( !$options->{version} ) {

    print {*STDOUT} <<'END_OF_USAGE';
amazon-credentials options

Formats credentials found in env, config, SSO, role

Options
-------
--account, -a    use with --role, specify AWS account id
--container, -c  get credentials from container IAM role
--ec2, -E        get credentials from EC2 IAM role
--env  -e        get credentials from environment variables
--help, -h       this
--profile, -p    get credentials from profile in credentials configuration
--role, -r       get credentials from SSO role
--token, -t      MFA token for MFA enabled profiles
--version, -v    version

 $ amazon-credentials --profile=test
  export AWS_ACCESS_KEY_ID=AKI*****************
  export AWS_SECRET_ACCESS_KEY=****************************************

 $ aws sso login
 $ amazon-credentials --role my-sso-role --account 01234567890

END_OF_USAGE
  }

  print {*STDOUT} "v$VERSION\n";

  exit SUCCESS;
}

########################################################################
sub export_credentials {
########################################################################
  my ($credentials) = @_;

  $credentials //= \%ENV;

  # Accept either the AWS_* environment-variable shape (e.g. %ENV, or a
  # credentials object) or the camelCase 'roleCredentials' shape returned
  # by the SSO GetRoleCredentials call (accessKeyId/secretAccessKey/
  # sessionToken). set_sso_credentials() returns the latter, so map each
  # export name to whichever key is present.
  my %sso_key_for = (
    AWS_ACCESS_KEY_ID     => 'accessKeyId',
    AWS_SECRET_ACCESS_KEY => 'secretAccessKey',
    AWS_SESSION_TOKEN     => 'sessionToken',
  );

  my @lines;

  foreach my $env_key (qw(AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN)) {
    my $value = $credentials->{$env_key} // $credentials->{ $sso_key_for{$env_key} };

    next
      if !defined $value;

    push @lines, sprintf "export %s=%s\n", $env_key, $value;
  }

  return join EMPTY, @lines;
}

########################################################################
sub main {
########################################################################
  my ($self) = @_;

  require Getopt::Long;

  Getopt::Long->import(qw(:config no_ignore_case));

  my %options;

  my @option_specs = qw(
    account|a=s
    container|c
    ec2|E
    env|e
    help|h
    profile|p=s
    role|r=s
    token|t=s
    version|v
  );

  if ( !GetOptions( \%options, @option_specs ) || $options{help} || $options{version} ) {
    help( \%options );
  }

  local $ENV{AMAZON_CREDENTIALS_MFA_TOKEN} = $options{token}
    if $options{token};

  my $creds = $self->new( profile => $options{profile} // EMPTY, );

  print {*STDOUT} $creds->format_credentials("export %s=%s\n");

  exit SUCCESS;
}

########################################################################
sub sanitize {
########################################################################
  my ( $self, $value ) = @_;

  my %sensitive = map { lc $_ => TRUE } qw(
    authorization
    aws_access_key_id
    aws_secret_access_key
    aws_session_token
    accesskeyid
    secretaccesskey
    sessiontoken
    token
    accesstoken
    refreshtoken
    clientsecret
    webidentitytoken
    x-amz-security-token
    x-amz-sso_bearer_token
    x-aws-ec2-metadata-token
  );

  if ( blessed($value) && $value->isa('HTTP::Request') ) {
    my $request = $value->clone;

    foreach my $header_name ( $request->header_field_names ) {
      next
        if !$sensitive{ lc $header_name };

      $request->header( $header_name => '[REDACTED]' );
    }

    return $request;
  }

  if ( blessed($value) && $value->isa('Amazon::Credentials::HTTP::Response') ) {
    my $response = $self->sanitize( $value->{response} );

    if ( defined $response->{content} && length $response->{content} ) {
      my $content = eval { decode_json( $response->{content} ) };

      if ( !$EVAL_ERROR && ref $content ) {
        $response->{content} = encode_json( $self->sanitize($content) );
      }
      else {
        $response->{content} = '[REDACTED]';
      }
    }

    return Amazon::Credentials::HTTP::Response->new($response);
  }

  if ( ref $value && reftype($value) eq 'HASH' ) {
    my %copy;

    foreach my $key ( keys %{$value} ) {
      if ( $sensitive{ lc $key } ) {
        $copy{$key} = '[REDACTED]';
        next;
      }

      $copy{$key} = $self->sanitize( $value->{$key} );
    }

    return \%copy;
  }

  if ( ref $value && reftype($value) eq 'ARRAY' ) {
    my @copy;

    for ( my $i = 0; $i < @{$value}; $i++ ) {
      my $item = $value->[$i];

      if ( !ref $item
        && $sensitive{ lc $item }
        && $i + 1 < @{$value} ) {
        push @copy, $item, '[REDACTED]';
        $i++;
        next;
      }

      push @copy, $self->sanitize($item);
    }

    return \@copy;
  }

  return $value;
}

1;

__END__

=pod

=encoding utf8

=head1 NAME

Amazon::Credentials - discover and manage AWS credentials

=head1 SYNOPSIS

 use Amazon::Credentials;

 my $credentials = Amazon::Credentials->new;

 my $access_key_id     = $credentials->get_aws_access_key_id;
 my $secret_access_key = $credentials->get_aws_secret_access_key;
 my $session_token     = $credentials->get_token;

 Use a named AWS profile:

 my $credentials = Amazon::Credentials->new( profile => 'sandbox' );

Or select the credential providers to search:

  my $credentials = Amazon::Credentials->new( order => [qw(env file container role)] );

Supply credentials explicitly:

  my $credentials = Amazon::Credentials->new(
    aws_access_key_id     => $access_key_id,
    aws_secret_access_key => $secret_access_key,
    token                 => $session_token,
  );

Retrieve credentials using standard AWS environment variable names:

  my $keys = $credentials->credential_keys;

  {
    AWS_ACCESS_KEY_ID     => ...,
    AWS_SECRET_ACCESS_KEY => ...,
    AWS_SESSION_TOKEN     => ...,
  }

=head1 DESCRIPTION

C<Amazon::Credentials> discovers AWS credentials and presents them through
a single interface.

The module uses a provider-based credential model. Credential sources are
implemented by provider classes, while C<Amazon::Credentials> acts as the
public facade that:

=over 4

=item * selects which credential providers may participate in discovery;

=item * controls the order in which top-level providers are searched;

=item * resolves AWS profiles into the provider that actually supplies credentials;

=item * retains the selected provider so temporary credentials can be refreshed;

=item * provides compatibility methods for applications written against earlier
versions of C<Amazon::Credentials>.

=back

=head2 Amazon::API Integration

C<Amazon::API> uses C<Amazon::Credentials> for AWS credential discovery
and management.

With the provider-based architecture introduced in version 2.0.0,
C<Amazon::API> can rely on C<Amazon::Credentials> for substantially more
than static access keys or basic environment and profile lookup. Profile
resolution may now include assumed roles, recursive C<source_profile>
chains, C<credential_source>, C<credential_process>, web identity,
AWS IAM Identity Center / SSO, MFA-assisted AssumeRole, ECS container
credentials, and EC2 instance role credentials.

This keeps credential discovery and refresh policy in
C<Amazon::Credentials>, while C<Amazon::API> can concentrate on AWS API
request construction, signing, and service behavior.

C<Amazon::Credentials> remains a standalone distribution and does not
require C<Amazon::API>.

=head2 Botocore Alignment

The credential model is intentionally aligned with the major credential
mechanisms and profile semantics supported by Botocore. The goal is not
strict behavioral parity, but to support the credential sources and
composition rules commonly used by AWS applications.

In particular, C<Amazon::Credentials> supports:

=over 4

=item * environment credentials;

=item * shared credentials and configuration files;

=item * C<credential_process>;

=item * web identity credentials;

=item * AWS IAM Identity Center / SSO;

=item * ECS container credentials;

=item * EC2 instance role credentials;

=item * C<AssumeRole> using C<source_profile>;

=item * recursive role chains;

=item * C<credential_source> using C<Environment>, C<Ec2InstanceMetadata>, or C<EcsContainer>.

=back

There are deliberate differences from Botocore.

=over 4

=item * Credential precedence and ordering

C<Amazon::Credentials> does not attempt to reproduce Botocore's exact
provider ordering. Provider precedence is configurable through C<order>
and C<plugins>.

Configurable provider selection can also avoid unnecessary discovery
latency by skipping credential sources that are known not to apply in
a given environment.

=item * Legacy Boto2 configuration files are not supported.

=item * Other differences

The module also does not attempt to duplicate Botocore's internal
provider classes, exception hierarchy, retry behavior, or other
implementation details where they are not required to resolve
credentials correctly.

=back

The intended compatibility boundary is AWS credential configuration and
resolution semantics, not Botocore's internal architecture.

=head2 MFA Support

MFA-assisted C<AssumeRole> profiles using C<mfa_serial> are supported.

When a selected profile contains C<mfa_serial>,
C<Amazon::Credentials> requires the current MFA token in the
C<AMAZON_CREDENTIALS_MFA_TOKEN> environment variable.

The variable is an C<Amazon::Credentials> convention and is not defined
by AWS.

For example:

  AMAZON_CREDENTIALS_MFA_TOKEN=123456 \
    AWS_PROFILE=admin \
    amazon-credentials

The token is passed to STS as C<TokenCode>, while C<mfa_serial> is passed
as C<SerialNumber>.

MFA tokens are not retained by the provider. If temporary credentials
are refreshed, a current C<AMAZON_CREDENTIALS_MFA_TOKEN> value must be
available at refresh time.

The same convention can be used when running any application that
discovers credentials through C<Amazon::Credentials>.

For example:

  AMAZON_CREDENTIALS_MFA_TOKEN=123456 \
    AWS_PROFILE=my-profile \
    some-script

In this form, both environment variables are scoped to that process
invocation. The script selects C<my-profile>, the resolver reads
C<mfa_serial> from that profile, and the supplied MFA token is used for
the resulting C<AssumeRole> request.

This is generally preferable to exporting
C<AMAZON_CREDENTIALS_MFA_TOKEN> into the shell environment because the
token is needed only for the credential acquisition operation and has a
short validity period.

=head1 ADDING CREDENTIAL PROVIDERS

C<Amazon::Credentials> supports registration of additional top-level
credential providers.

This facility is intended primarily for environments that obtain AWS
credentials from infrastructure outside the standard AWS credential
chain. Examples might include an organization-provided credential broker,
a local credential agent, or a platform-specific metadata service that
already issues AWS credentials.

It should generally not be necessary to create a custom provider merely
to alter how standard AWS profiles are interpreted. Profile composition,
including C<credential_process>, SSO, web identity, C<source_profile>,
C<credential_source>, and assumed roles, belongs in the profile resolver.

Similarly, a provider should not normally introduce a new mechanism for
persisting long-lived AWS credentials. Applications should prefer
short-lived credentials issued by an authenticated credential service
over custom credential files or embedded secrets.

=head2 Provider Contract

A provider is registered with:

  Amazon::Credentials->register_provider('My::Credentials::Provider');

The provider name is derived from the final component of the package
name and converted to snake_case.

For example:

  My::Credentials::Provider::CredentialBroker
      => credential_broker

A top-level provider constructor receives the current discovery context
as a hash reference.

A provider may return C<undef> when it is not applicable in the current
environment.

If it returns an object, that object must represent usable credentials
and provide the interface expected by C<Amazon::Credentials::Provider>.

Custom providers will normally subclass C<Amazon::Credentials::Provider>
so that the common credential accessors and default refresh behavior are
inherited.

The C<credentials> method returns the normalized credential tuple used by
the facade.

C<is_refreshable> reports whether the provider can refresh its credentials.
A refreshable provider implements C<refresh_credentials> and owns its
refresh mechanism. Refreshing credentials must not require
C<Amazon::Credentials> to rediscover the provider.

=head2 Provider Registration and Selection

A custom provider must be registered before it can be used.

  Amazon::Credentials->register_provider('My::Credentials::Provider::CredentialBroker');

Registration makes the provider known to
C<Amazon::Credentials>. It does not automatically
add the provider to the default credential chain.

After registration, the provider may be selected through C<order> or
C<plugins>.

  Amazon::Credentials->register_provider('My::Credentials::Provider::CredentialBroker');

  my $credentials = Amazon::Credentials->new( order => [qw(credential_broker env file)], );

Installing or loading a provider module is not sufficient. Until the
provider is registered, C<Amazon::Credentials> does not know that it is
available.

This separation is intentional. Registration controls availability;
C<order> and C<plugins> control participation and precedence.

=head2 Providers Versus Resolvers

A provider produces credentials.

A resolver interprets configuration and selects the provider that should
produce those credentials.

This distinction is important.

For example, an AWS profile containing:

  role_arn = ...
  source_profile = ...

does not itself produce credentials. The profile resolver interprets the
configuration, resolves the source profile, and constructs an
C<AssumeRole> provider.

Custom extensions should preserve the same separation. If an extension
primarily interprets configuration or delegates to other providers, it
is probably a resolver rather than a credential provider.

=head1 CREDENTIAL PROVIDERS

The built-in top-level credential providers are:

=over 4

=item C<env>

Credentials supplied through AWS environment variables.

=item C<container>

Credentials supplied through the ECS container credential endpoint.

=item C<role>

Credentials supplied through the EC2 instance metadata service.

=item C<web_identity>

Credentials obtained using a web identity token and
C<AssumeRoleWithWebIdentity>.

=item C<file>

AWS configuration and credentials files.

The C<file> entry is a profile resolver. A profile may resolve to static
credentials or to another credential-producing provider.

=back

The default search order is:

  env
  container
  role
  web_identity
  file

This is the default policy of C<Amazon::Credentials>. It is configurable
and is not intended to duplicate Botocore's provider order exactly.

=head2 Profile Resolution

AWS profiles are resolved according to the contents of
F<~/.aws/credentials> and F<~/.aws/config>.

A profile may resolve to:

=over 4

=item * static access keys;

=item * C<credential_process>;

=item * AWS IAM Identity Center / SSO credentials;

=item * web identity credentials;

=item * an assumed role using C<role_arn> and C<source_profile>;

=item * an assumed role using C<role_arn> and C<credential_source>.

=back

C<source_profile> resolution is recursive. A source profile may itself
resolve through another supported credential mechanism.

Recursive role chains are supported and cycles are rejected.

Supported C<credential_source> values are:

  Environment
  Ec2InstanceMetadata
  EcsContainer

=head1 CONSTRUCTOR

=head2 new

  my $credentials = Amazon::Credentials->new(%options);

or:

  my $credentials = Amazon::Credentials->new(\%options);

Discovers credentials and returns an C<Amazon::Credentials> object.

If explicit access keys are supplied, provider discovery is skipped.

If C<sso_role_name> and C<sso_account_id> are supplied, the constructor
uses the SSO provider directly.

Otherwise the configured provider chain is searched until credentials are
found.

If no provider produces credentials, the constructor reports:

  no credentials available

The behavior of discovery failures is controlled by C<raise_error> and
C<print_error>.

=head2 Constructor Options

=head3 aws_access_key_id / aws_secret_access_key

Explicit AWS credentials.

Both values must be supplied together.

When both are present, normal credential discovery is bypassed.

A temporary session token may also be supplied with C<token>.

  my $credentials = Amazon::Credentials->new(
  aws_access_key_id     => $access_key_id,
  aws_secret_access_key => $secret_access_key,
  token                 => $session_token,
  );

=head3 cache

Controls whether credential values remain available after they are read.

Caching is enabled by default.

  my $credentials = Amazon::Credentials->new( cache => 0 );

When caching is disabled, each credential getter is effectively one-shot.
After a credential value is returned, the stored closure for that value is
replaced with one returning C<undef>.

Disabling the cache does not perform credential rediscovery and does not
guarantee that Perl has erased the underlying string from process memory.

See L</SECURITY CONSIDERATIONS>.

=head3 debug

Enables debug logging.

  my $credentials = Amazon::Credentials->new(debug => 1);

The default logger writes debug messages to STDERR.

Sensitive request headers and credential-shaped data should be passed
through C<sanitize> before being logged.

=head3 imdsv2

Controls use of IMDSv2 for EC2 instance metadata credentials.

Valid values are:

=over 4

=item C<preferred>

The default.

C<Amazon::Credentials> attempts IMDSv2 first. If IMDSv2 token
acquisition fails, it falls back to IMDSv1. If the instance metadata
service still does not yield credentials, discovery continues with the
remaining providers.

=item C<required>

IMDSv2 token acquisition is required. Failure is fatal for the
instance-role provider.

=item C<disabled>

IMDSv2 token acquisition is skipped and instance metadata is accessed
using IMDSv1.

=back

For compatibility, numeric values are also accepted:

  0  => disabled
  1  => required

=head3 logger

A logger object with a C<debug> method.

  my $credentials = Amazon::Credentials->new( logger => $logger );

If no logger is supplied, a minimal logger writing to STDERR is used.

=head3 order

An array reference specifying the order in which top-level credential
providers are searched.

  my $credentials = Amazon::Credentials->new( order => [qw(file env role)] );

The standard provider names are:

  env
  container
  role
  web_identity
  file

C<order> controls precedence. It does not register providers.

If C<plugins> is also supplied, every entry in C<order> must also be
enabled by C<plugins>.

=head3 plugins

Restricts the top-level providers that may participate in credential
discovery.

  my $credentials = Amazon::Credentials->new( plugins => [qw(env file)] );

If C<order> is not supplied, the order of the C<plugins> list becomes the
search order.

If both C<plugins> and C<order> are supplied:

  plugins = availability
  order   = precedence

For example:

  my $credentials = Amazon::Credentials->new(
    plugins => [qw(env file role)],
    order   => [qw(file env role)]
  );

A provider selected by C<order> but not enabled by C<plugins> causes an
exception.

=head3 profile

Selects an AWS profile.

  my $credentials = Amazon::Credentials->new( profile => 'sandbox', );

If C<profile> is not supplied, C<AWS_PROFILE> is used when present.

When a profile is explicitly selected and neither C<order> nor C<plugins>
has been supplied, discovery is restricted to the profile resolver.

This prevents unrelated environment, container, or instance-role
credentials from taking precedence over an explicitly requested profile.

=head3 print_error

Controls whether a discovery error is reported with C<carp> when it is
not raised as an exception.

The default is true.

This option is mainly useful when C<raise_error> is false.

=head3 raise_error

Controls whether credential discovery failures are raised with C<croak>.

The default is true.

  my $credentials = Amazon::Credentials->new(
    raise_error => 0,
    print_error => 0,
  );

The most recent discovery error can then be retrieved with:

  my $error = $credentials->get_error;

=head3 region

Provides a region to credential providers that require regional context.

  my $credentials = Amazon::Credentials->new( region => 'us-east-1', );

A selected provider or AWS profile may also establish the region.

Region is part of credential discovery context. Refreshing temporary
credentials does not cause C<Amazon::Credentials> to rediscover or change
the facade's region.

=head3 sso_account_id / sso_role_name

Compatibility options for directly obtaining AWS IAM Identity Center /
SSO role credentials without selecting a profile.

Both values are required together.

  my $credentials = Amazon::Credentials->new(
    sso_account_id => '123456789012',
    sso_role_name  => 'AdministratorAccess',
    sso_region     => 'us-east-1',
  );

The SSO provider searches the AWS SSO token cache for a usable access
token and requests role credentials for the requested account and role.

Profile-based SSO configuration is preferred for new applications.

=head3 sso_region

Region used for direct SSO credential retrieval.

If omitted, C<region> is used when available.

=head3 timeout

HTTP timeout in seconds used by the default user agent.

default: 3

=head3 token

Session token associated with explicitly supplied temporary credentials.

=head3 user_agent

A custom HTTP user agent.

The object must provide:

  request($http_request)

and return an object implementing the response interface expected by
C<Amazon::Credentials>.

The default is C<Amazon::Credentials::HTTP::UserAgent>, which uses
C<HTTP::Tiny>.

This option is primarily useful for testing or for applications requiring
custom HTTP behavior.

=head1 CREDENTIAL ACCESS

=head2 get_aws_access_key_id

  my $access_key_id = $credentials->get_aws_access_key_id;

Returns the AWS access key ID.

=head2 get_aws_secret_access_key

  my $secret_access_key = $credentials->get_aws_secret_access_key;

Returns the AWS secret access key.

=head2 get_token

  my $session_token = $credentials->get_token;

Returns the AWS session token when temporary credentials are in use.

=head2 get_aws_session_token

Alias for C<get_token>.

=head2 credential_keys

  my $keys = $credentials->credential_keys;

Returns a hash reference using standard AWS environment variable names:

  { AWS_ACCESS_KEY_ID     => ...,
    AWS_SECRET_ACCESS_KEY => ...,
    AWS_SESSION_TOKEN     => ...,
  }

C<AWS_SESSION_TOKEN> is omitted when no session token is present.

=head2 as_string

  my $json = $credentials->as_string;

Returns C<credential_keys> encoded as formatted JSON.

=head2 format_credentials

  my $text = $credentials->format_credentials("export %s=%s\n");

Formats each entry returned by C<credential_keys> using the supplied
C<sprintf> format.

The default format is:

  "%s %s\n"

=head1 PROVIDER INFORMATION

=head2 get_provider

Returns the provider object that actually produced the credentials.

For profile-based credentials this is the resolved provider, not the
profile resolver.

For example, a profile containing C<credential_process> produces a
C<Provider::Process> object, while a profile containing C<role_arn>
produces a C<Provider::AssumeRole> object.

This distinction is important because credential refresh is delegated to
the credential-producing provider.

=head2 get_source

Returns the credential source reported by the selected provider.

=head2 get_region

Returns the region established during credential discovery.

=head1 TEMPORARY CREDENTIALS AND REFRESH

=head2 get_expiration

  my $expiration = $credentials->get_expiration;

Returns the expiration timestamp reported by the selected provider.

Returns C<undef> when there is no provider or the credentials do not
expire.

=head2 set_expiration

  $credentials->set_expiration($expiration);

Sets the expiration value on the selected provider.

This method is retained primarily for compatibility.

=head2 is_token_expired

  if ( $credentials->is_token_expired ) {
    ...
  }

Returns true when the credential expiration time falls within the
configured expiration window.

The default window is five minutes.

A different window, in minutes, may be supplied:

  if ( $credentials->is_token_expired(10) ) {
    ...
  }

Credentials with no expiration are considered non-expiring.

=head2 refresh_token

  $credentials->refresh_token;

Refreshes temporary credentials using the selected provider.

Only providers that declare themselves refreshable may be refreshed.

The provider owns the refresh mechanism. Depending on the credential
source, refresh may mean:

=over 4

=item * rerunning C<credential_process>;

=item * requesting new SSO role credentials;

=item * refreshing an SSO access token before requesting role credentials;

=item * rereading a web identity token and calling STS;

=item * refreshing an assumed role, including refreshing its source provider when
necessary.

=back

After the provider refreshes, the facade reloads the access key, secret
key, and session token from that provider. Expiration remains provider
state and is read through C<get_expiration>.

Refresh does not rerun credential discovery, select a new provider, or
change the facade's discovery context.

Calling C<refresh_token> for non-refreshable credentials raises:

credentials are not refreshable

=head1 EXPLICIT CREDENTIAL MANAGEMENT

=head2 set_credentials

  $credentials->set_credentials(
    { aws_access_key_id     => $access_key_id,
      aws_secret_access_key => $secret_access_key,
      token                 => $session_token,
    }
  );

Replaces the credential tuple held by the facade.

C<aws_access_key_id> and C<aws_secret_access_key> are required.

The session token may be supplied as either:

  token
  aws_session_token

=head2 reset_credentials

  $credentials->reset_credentials;

Clears the credential values currently held by the facade.

This does not perform credential discovery.


=head1 AWS PROFILE FEATURES

=head2 Static Credentials

Static credentials may be read from AWS credentials and configuration
files.

=head2 credential_process

Profiles containing:

  credential_process = command ...

are resolved through the process provider.

The process output may contain temporary credentials and expiration
information. Refreshable process credentials are refreshed by running the
process again.

=head2 AssumeRole

Profiles containing C<role_arn> may obtain source credentials using
either:

  source_profile

or:

  credential_source

C<source_profile> may resolve recursively.

The AssumeRole provider supports the profile options implemented by this
distribution, including role session name, external ID, and duration when
present.

MFA-assisted AssumeRole profiles using C<mfa_serial> are supported.
See L</MFA Support>.

=head2 Web Identity

Web identity credentials may be discovered from the standard web identity
environment or from profile configuration.

The token file is reread when credentials are refreshed.

=head2 AWS IAM Identity Center / SSO

Both modern C<sso_session> profiles and legacy inline SSO profiles are
supported.

Modern configuration may use:

  [profile sandbox]
  sso_session = company
  sso_account_id = 123456789012
  sso_role_name = AdministratorAccess

  [sso-session company]
  sso_start_url = https://example.awsapps.com/start
  sso_region = us-east-1

Legacy inline profiles may use:

  [profile sandbox]
  sso_start_url = https://example.awsapps.com/start
  sso_region = us-east-1
  sso_account_id = 123456789012
  sso_role_name = AdministratorAccess

SSO access tokens are read from the AWS SSO cache.

When the cached access token can be refreshed, the SSO provider may
refresh it before obtaining new role credentials.

=head1 EXPORTED FUNCTIONS

Nothing is exported by default.

The following function-shaped helpers may be imported explicitly.

=head2 normalize_arn

use Amazon::Credentials qw(normalize_arn);

  my $iam_arn = normalize_arn($sts_arn);

Converts an STS assumed-role ARN:

  arn:aws:sts::123456789012:assumed-role/MyRole/session-name

to the corresponding IAM role ARN:

  arn:aws:iam::123456789012:role/MyRole

Other ARNs are returned unchanged.

The function may also be called as a method:

  my $iam_arn = $credentials->normalize_arn($sts_arn);

=head2 get_role_credentials

  use Amazon::Credentials qw(get_role_credentials);

  my $role_credentials = get_role_credentials(
    account_id => '123456789012',
    role_name  => 'AdministratorAccess',
    region     => 'us-east-1',
  );

Compatibility interface for obtaining SSO role credentials directly.

The returned hash uses the field names returned by the AWS SSO
GetRoleCredentials API, including:

  accessKeyId
  secretAccessKey
  sessionToken
  expiration

New code will usually be simpler when SSO is configured through an AWS
profile and discovered through C<Amazon::Credentials->new>.

=head2 set_sso_credentials

use Amazon::Credentials qw(set_sso_credentials);

  my $role_credentials = set_sso_credentials( 'AdministratorAccess', '123456789012', 'us-east-1', );

Compatibility interface for obtaining SSO role credentials and placing
them into:

  AWS_ACCESS_KEY_ID
  AWS_SECRET_ACCESS_KEY
  AWS_SESSION_TOKEN

The returned value is the raw SSO role credential hash.

This function mutates C<%ENV>. New applications should generally prefer
constructing an C<Amazon::Credentials> object.

=head1 ERROR HANDLING

Credential discovery errors are retained in:

  $credentials->get_error

By default, discovery errors are raised as exceptions.

To inspect failures without raising an exception:

  my $credentials = Amazon::Credentials->new(
    raise_error => 0,
    print_error => 0,
  );

  if ( my $error = $credentials->get_error ) {
    ...
  }

Errors originating from an explicitly selected provider or an invalid
configuration may be fatal because continuing to another provider would
hide a configuration error.

=head1 SECURITY CONSIDERATIONS

AWS credentials are secrets. The primary risk is not merely that a
process can retrieve them, but that credentials can leave the process
through logs, diagnostics, serialization, crash data, or other accidental
output.

=head2 Credential Storage

Credential values held by C<Amazon::Credentials> are captured in lexical
closures rather than stored as ordinary scalar object attributes.

As a result, ordinary object inspection such as:

  print Dumper($credentials);

shows code references rather than exposing the credential strings stored
inside those closures.

This reduces the chance of accidentally exposing credentials through
object serialization or diagnostic dumps.

It does not make process memory cryptographically secure.

=head2 Caching

With the default:

  cache => 1

credential values remain available through their getters.

With:

  cache => 0

a credential getter clears its stored closure after returning the value.

This can reduce how long the facade retains an immediately accessible
credential value, but Perl does not guarantee that the memory previously
holding the string has been overwritten.

Do not treat C<cache =E<gt> 0> as secure memory erasure.


=head2 Sanitizing Diagnostic Data

  my $safe = $credentials->sanitize($value);

C<sanitize> recursively redacts credential-shaped and token-shaped values
from structures used for diagnostic logging.

It handles common sensitive keys including access keys, session tokens,
SSO tokens, authorization headers, web identity tokens, and IMDSv2
tokens.

C<HTTP::Request> objects are cloned before sensitive headers are replaced.

C<Amazon::Credentials::HTTP::Response> content is sanitized when it
contains structured JSON; opaque response content is replaced rather
than logged verbatim.

=head2 Logging

Do not log access keys, secret keys, session tokens, SSO tokens,
authorization headers, web identity tokens, or metadata service tokens.

Use C<sanitize> on request, response, and structured diagnostic data
before logging values that may contain credentials.

Debug mode must be enabled explicitly:

  Amazon::Credentials->new(debug => 1,);

The C<DEBUG> environment variable does not implicitly enable debugging.

=head2 IAM Permissions

Use credentials with the minimum permissions required by the
application.

Where practical, prefer short-lived role credentials over long-lived
static access keys.

=head1 COMMAND LINE INTERFACE

The distribution installs:

  amazon-credentials

Use:

  amazon-credentials --help

for command-line usage information.

The command-line program provides access to the same credential discovery
and resolution mechanisms as the C<Amazon::Credentials> API.

It is useful for obtaining credentials for shells, scripts, command-line
tools, and other applications that consume standard AWS environment
variables. In particular, it can resolve profile-based temporary
credentials, including assumed roles, SSO credentials, and MFA-assisted
C<AssumeRole> profiles.

For example:

  eval "$(amazon-credentials --profile my-profile)"

or for an MFA-assisted profile:

  eval "$(amazon-credentials \
    --profile my-profile \
    --token 123456)"

=head1 COMPATIBILITY

The provider architecture is a substantial internal change from earlier
releases.

The public C<Amazon::Credentials> facade retains compatibility methods
where doing so does not conflict with the provider model, including
explicit credentials, SSO helper functions, credential getters, token
expiration helpers, provider ordering, and formatting methods.

The provider registration API and provider contract documented in
L</ADDING CREDENTIAL PROVIDERS> are supported extension points. Resolver
internals, concrete built-in provider implementations, and underscored
methods should not be treated as stable application interfaces unless
separately documented.

=head1 INCOMPATIBILITIES

This module has not been tested on Windows.

