package Amazon::Credentials::Provider;

use strict;
use warnings;

use 5.010;

use parent qw(Class::Accessor::Fast);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    created_at
    debug
    last_refreshed
    logger
    profile
    expiration
    region
    source
    timeout
    user_agent
  )
);

use Carp;

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  croak 'aws_access_key_id is required'
    if !$options->{aws_access_key_id};

  croak 'aws_secret_access_key is required'
    if !$options->{aws_secret_access_key};

  my $aws_access_key_id     = delete $options->{aws_access_key_id};
  my $aws_secret_access_key = delete $options->{aws_secret_access_key};
  my $token                 = delete $options->{token};

  $options->{created_at} //= time;

  my $self = $class->SUPER::new($options);

  $self->set_aws_access_key_id($aws_access_key_id);
  $self->set_aws_secret_access_key($aws_secret_access_key);
  $self->set_token($token);

  return $self;
}

########################################################################
sub credentials {
########################################################################
  my ($self) = @_;

  my $credentials = {
    aws_access_key_id     => $self->get_aws_access_key_id,
    aws_secret_access_key => $self->get_aws_secret_access_key,
    source                => $self->get_source,
  };

  $credentials->{token} = $self->get_token
    if defined $self->get_token;

  $credentials->{expiration} = $self->get_expiration
    if defined $self->get_expiration;

  $credentials->{region} = $self->get_region
    if defined $self->get_region;

  return $credentials;
}

########################################################################
sub is_refreshable {
########################################################################
  return 0;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  croak sprintf '%s does not support credential refresh', ref $self;
}

########################################################################
sub get_aws_access_key_id {
########################################################################
  my ($self) = @_;

  return $self->{_access_key_id}->();
}

########################################################################
sub set_aws_access_key_id {
########################################################################
  my ( $self, $value ) = @_;

  $self->{_access_key_id} = sub {$value};

  return;
}

########################################################################
sub get_aws_secret_access_key {
########################################################################
  my ($self) = @_;

  return $self->{_secret_access_key}->();
}

########################################################################
sub set_aws_secret_access_key {
########################################################################
  my ( $self, $value ) = @_;

  $self->{_secret_access_key} = sub {$value};

  return;
}

########################################################################
sub get_token {
########################################################################
  my ($self) = @_;

  return $self->{_session_token}->();
}

########################################################################
sub set_token {
########################################################################
  my ( $self, $value ) = @_;

  $self->{_session_token} = sub {$value};

  return;
}

1;
