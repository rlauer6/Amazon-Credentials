package Amazon::Credentials::Utils;

use strict;
use warnings;

use parent qw(Exporter);

our @EXPORT_OK = qw(choose);

########################################################################
sub choose(&) { ## no critic
########################################################################
  my $code = shift;

  # Pass the correct context down to the block
  if (wantarray) {
    return $code->();
  }
  elsif ( defined wantarray ) {
    return scalar $code->();
  }
  else {
    $code->();
    return;
  }
}

1;
