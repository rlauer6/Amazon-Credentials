package Amazon::Credentials::Provider::Config;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

use Carp;
use Role::Tiny::With;

with 'Amazon::Credentials::Role::File';

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  my $profile = $options->{profile} || 'default';

  my $self = bless {}, $class;

  my $config = $self->_get_profile($profile);

  return
    if !$config;

  my $access_key = $config->{aws_access_key_id};
  my $secret_key = $config->{aws_secret_access_key};

  return
    if !$access_key && !$secret_key;

  croak "profile '$profile' contains aws_access_key_id but no aws_secret_access_key"
    if $access_key && !$secret_key;

  croak "profile '$profile' contains aws_secret_access_key but no aws_access_key_id"
    if !$access_key && $secret_key;

  return $class->SUPER::new(
    %{$options},
    aws_access_key_id     => $access_key,
    aws_secret_access_key => $secret_key,
    region                => $config->{region},
    source                => 'config',
    token                 => $config->{aws_session_token},
  );
}

1;
