package Amazon::Credentials::Provider::SSO;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    account_id
    cache_key
    profile
    role_name
    session_name
    sso_region
    sso_start_url
    user_agent
  )
);

use Amazon::Credentials::HTTP::UserAgent;
use Carp;
use English qw(-no_match_vars);
use HTTP::Request;
use JSON;
use Role::Tiny::With;

with 'Amazon::Credentials::Role::File';
with 'Amazon::Credentials::Role::SSOCache';

use constant { ## no critic
  DEFAULT_REGION => 'us-east-1',
};

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  return $class->_new_from_options($options)
    if $options->{sso_account_id} || $options->{sso_role_name};

  return $class->_new_from_profile($options);
}

########################################################################
sub _new_from_options {
########################################################################
  my ( $class, $options ) = @_;

  my $account_id = $options->{sso_account_id};
  my $role_name  = $options->{sso_role_name};

  croak 'sso_account_id and sso_role_name are both required'
    if !$account_id || !$role_name;

  my $sso_region = $options->{sso_region} || $options->{region} || DEFAULT_REGION;

  my $ua = $options->{user_agent} || Amazon::Credentials::HTTP::UserAgent->new;

  #
  # Direct SSO credentials have no profile/session information from
  # which to derive a cache key. Search the SSO cache and use the
  # freshest usable access token.
  #
  my $access_token = $class->_get_access_token(
    region     => $sso_region,
    user_agent => $ua,
  );

  croak 'no valid SSO token in cache; run: aws sso login'
    if !$access_token;

  my $credentials = $class->_get_role_credentials(
    account_id   => $account_id,
    access_token => $access_token,
    region       => $sso_region,
    role_name    => $role_name,
    user_agent   => $ua,
  );

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{accessKeyId},
    aws_secret_access_key => $credentials->{secretAccessKey},
    expiration            => _normalize_expiration( $credentials->{expiration} ),
    region                => $options->{region} || $sso_region,
    source                => 'sso',
    token                 => $credentials->{sessionToken},
  );

  $self->set_account_id($account_id);
  $self->set_role_name($role_name);
  $self->set_sso_region($sso_region);
  $self->set_user_agent($ua);

  return $self;
}

########################################################################
sub _new_from_profile {
########################################################################
  my ( $class, $options ) = @_;

  my $profile = $options->{profile} || 'default';

  my $sections = $class->_get_profile_sections($profile);

  return
    if !@{$sections};

  my $config = $class->_get_profile($profile);

  my $account_id = $config->{sso_account_id};
  my $role_name  = $config->{sso_role_name};

  return
    if !$account_id && !$role_name && !$config->{sso_session} && !$config->{sso_start_url};

  croak "profile '$profile' contains incomplete SSO configuration"
    if !$account_id || !$role_name;

  my ( $session_name, $sso_region, $sso_start_url, $cache_key );

  if ( $config->{sso_session} ) {
    $session_name = $config->{sso_session};

    my $session;

    foreach my $entry ( @{$sections} ) {
      $session = $entry->{ini}->{"sso-session $session_name"};

      last
        if $session;
    }

    croak "no [sso-session $session_name] section for profile '$profile'"
      if !$session;

    $sso_region    = $session->{sso_region};
    $sso_start_url = $session->{sso_start_url};
    $cache_key     = $class->_sso_cache_key($session_name);
  }
  else {
    $sso_region    = $config->{sso_region};
    $sso_start_url = $config->{sso_start_url};
    $cache_key     = $class->_sso_cache_key($sso_start_url);
  }

  $sso_region ||= $config->{region} || $options->{region} || DEFAULT_REGION;

  croak "profile '$profile' contains no SSO start URL"
    if !$sso_start_url;

  my $ua = $options->{user_agent} || Amazon::Credentials::HTTP::UserAgent->new;

  my $access_token = $class->_get_access_token(
    cache_key  => $cache_key,
    region     => $sso_region,
    user_agent => $ua,
  );

  croak 'no valid SSO token in cache; run: aws sso login'
    if !$access_token;

  my $credentials = $class->_get_role_credentials(
    account_id   => $account_id,
    access_token => $access_token,
    region       => $sso_region,
    role_name    => $role_name,
    user_agent   => $ua,
  );

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{accessKeyId},
    aws_secret_access_key => $credentials->{secretAccessKey},
    expiration            => _normalize_expiration( $credentials->{expiration} ),
    region                => $config->{region} || $sso_region,
    source                => 'sso',
    token                 => $credentials->{sessionToken},
  );

  $self->set_account_id($account_id);
  $self->set_cache_key($cache_key);
  $self->set_profile($profile);
  $self->set_role_name($role_name);
  $self->set_session_name($session_name);
  $self->set_sso_region($sso_region);
  $self->set_sso_start_url($sso_start_url);
  $self->set_user_agent($ua);

  return $self;
}

########################################################################
sub _get_role_credentials {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my $host = sprintf
    'portal.sso.%s.amazonaws.com',
    $options->{region};

  my $url = sprintf
    'https://%s/federation/credentials?account_id=%s&role_name=%s',
    $host,
    $options->{account_id},
    $options->{role_name};

  my $req = HTTP::Request->new( GET => $url );

  $req->header( ':x-amz-sso_bearer_token', $options->{access_token} );

  my $rsp = $options->{user_agent}->request($req);

  croak "no response from get($url)"
    if !$rsp;

  my $content = eval { return decode_json( $rsp->content ) if $rsp->content_type eq 'application/json'; };

  croak "could not decode response from GetRoleCredentials\n$EVAL_ERROR"
    if !$content;

  return $content->{roleCredentials}
    if $rsp->is_success;

  croak sprintf
    "Status: %s\n%s",
    $rsp->status_line,
    $content->{message};
}

########################################################################
sub get_role_credentials {
########################################################################
  my ( $class, @args ) = @_;

  my $options
    = ref $args[0]
    ? { %{ $args[0] } }
    : {@args};

  my $account_id = $options->{account_id};
  my $role_name  = $options->{role_name};

  croak 'account_id and role_name are both required'
    if !$account_id || !$role_name;

  my $region
    = $options->{region}
    || $ENV{AWS_REGION}
    || $ENV{AWS_DEFAULT_REGION}
    || DEFAULT_REGION;

  my $ua = $options->{user_agent}
    || Amazon::Credentials::HTTP::UserAgent->new;

  my $access_token = $options->{access_token};

  #
  # The public compatibility API historically allowed callers to omit
  # the access token. In that case use the freshest usable token from
  # the AWS SSO cache.
  #
  if ( !$access_token ) {
    $access_token = $class->_get_access_token(
      region     => $region,
      user_agent => $ua,
    );
  }

  croak 'no access token'
    if !$access_token;

  return $class->_get_role_credentials(
    account_id   => $account_id,
    access_token => $access_token,
    region       => $region,
    role_name    => $role_name,
    user_agent   => $ua,
  );
}

########################################################################
sub _normalize_expiration {
########################################################################
  my ($expiration) = @_;

  return $expiration
    if !defined $expiration
    || $expiration !~ /\A\d+\z/xsm;

  my @g = gmtime int $expiration / 1000;

  return sprintf
    '%04d-%02d-%02dT%02d:%02d:%02dZ',
    $g[5] + 1900,
    $g[4] + 1,
    @g[ 3, 2, 1, 0 ];
}

########################################################################
sub is_refreshable {
########################################################################
  return 1;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  my $access_token = $self->_get_access_token(
    cache_key  => $self->get_cache_key,
    region     => $self->get_sso_region,
    user_agent => $self->get_user_agent,
  );

  croak 'no valid SSO token in cache; run: aws sso login'
    if !$access_token;

  my $credentials = $self->_get_role_credentials(
    account_id   => $self->get_account_id,
    access_token => $access_token,
    region       => $self->get_sso_region,
    role_name    => $self->get_role_name,
    user_agent   => $self->get_user_agent,
  );

  $self->set_aws_access_key_id( $credentials->{accessKeyId} );

  $self->set_aws_secret_access_key( $credentials->{secretAccessKey} );

  $self->set_token( $credentials->{sessionToken} );

  $self->set_expiration( _normalize_expiration( $credentials->{expiration} ) );

  $self->set_last_refreshed(time);

  return $self;
}

1;
