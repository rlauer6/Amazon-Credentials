package Amazon::Credentials::Provider::WebIdentity;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    role_arn
    role_session_name
    token_file
    user_agent
  )
);

use Amazon::Credentials::HTTP::UserAgent;
use Carp;
use English qw(-no_match_vars);
use HTTP::Request;

use constant { ## no critic
  DEFAULT_REGION       => 'us-east-1',
  DEFAULT_SESSION_NAME => 'amazon-credentials-session',
};

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  my $token_file = $options->{token_file} // $ENV{AWS_WEB_IDENTITY_TOKEN_FILE};

  my $role_arn = $options->{role_arn} // $ENV{AWS_ROLE_ARN};

  return
    if !$token_file && !$role_arn;

  croak 'AWS_WEB_IDENTITY_TOKEN_FILE is set but AWS_ROLE_ARN is not set'
    if $token_file && !$role_arn;

  croak 'AWS_ROLE_ARN is set but AWS_WEB_IDENTITY_TOKEN_FILE is not set'
    if !$token_file && $role_arn;

  my $role_session_name = $options->{role_session_name} // $ENV{AWS_ROLE_SESSION_NAME} // DEFAULT_SESSION_NAME;

  my $region = $options->{region} // $ENV{AWS_REGION} // $ENV{AWS_DEFAULT_REGION} // DEFAULT_REGION;

  my $ua = $options->{user_agent}
    || Amazon::Credentials::HTTP::UserAgent->new;

  my $credentials = $class->_get_credentials(
    region            => $region,
    role_arn          => $role_arn,
    role_session_name => $role_session_name,
    token_file        => $token_file,
    user_agent        => $ua,
  );

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{AccessKeyId},
    aws_secret_access_key => $credentials->{SecretAccessKey},
    expiration            => $credentials->{Expiration},
    region                => $region,
    source                => 'web_identity',
    token                 => $credentials->{SessionToken},
  );

  $self->set_role_arn($role_arn);
  $self->set_role_session_name($role_session_name);
  $self->set_token_file($token_file);
  $self->set_user_agent($ua);

  return $self;
}

########################################################################
sub _get_credentials {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my $token = _read_token_file( $options->{token_file} );

  my $sts_host = sprintf
    'https://sts.%s.amazonaws.com',
    $options->{region};

  my %params = (
    Action           => 'AssumeRoleWithWebIdentity',
    RoleArn          => $options->{role_arn},
    RoleSessionName  => $options->{role_session_name},
    Version          => '2011-06-15',
    WebIdentityToken => $token,
  );

  my $query = join q{&}, map { _uri_escape($_) . q{=} . _uri_escape( $params{$_} ) }
    sort keys %params;

  my $url = "$sts_host/?$query";

  my $req = HTTP::Request->new( GET => $url );

  $req->header( Accept => '*/*' );

  my $rsp = $options->{user_agent}->request($req);

  croak 'no response from AssumeRoleWithWebIdentity'
    if !$rsp;

  if ( !$rsp->is_success ) {
    my $detail = _extract_sts_error( $rsp->content );

    croak sprintf
      'AssumeRoleWithWebIdentity failed: %s%s',
      $rsp->status_line,
      $detail;
  }

  my $xml = $rsp->content;

  my $credentials = {
    AccessKeyId     => _xml_element( $xml, 'AccessKeyId' ),
    SecretAccessKey => _xml_element( $xml, 'SecretAccessKey' ),
    SessionToken    => _xml_element( $xml, 'SessionToken' ),
    Expiration      => _xml_element( $xml, 'Expiration' ),
  };

  croak 'AssumeRoleWithWebIdentity returned no AccessKeyId'
    if !$credentials->{AccessKeyId};

  croak 'AssumeRoleWithWebIdentity returned no SecretAccessKey'
    if !$credentials->{SecretAccessKey};

  return $credentials;
}

########################################################################
sub _read_token_file {
########################################################################
  my ($token_file) = @_;

  open my $fh, '<', $token_file
    or croak "cannot open web identity token file '$token_file': $OS_ERROR";

  my $token;

  {
    local $RS = undef;
    $token = <$fh>;
  }

  close $fh
    or croak "cannot close web identity token file '$token_file': $OS_ERROR";

  chomp $token
    if defined $token;

  croak "web identity token file '$token_file' is empty"
    if !defined $token || !length $token;

  return $token;
}

########################################################################
sub _xml_element {
########################################################################
  my ( $xml, $tag ) = @_;

  if ( $xml =~ m{<$tag>([^<]+)</$tag>}xsm ) {
    return $1;
  }

  return undef; ## no critic
}

########################################################################
sub _extract_sts_error {
########################################################################
  my ($xml) = @_;

  return q{}
    if !defined $xml || !length $xml;

  my $code = _xml_element( $xml, 'Code' ) // q{};

  my $message = _xml_element( $xml, 'Message' ) // q{};

  return q{}
    if !$code && !$message;

  return " - $code: $message";
}

########################################################################
sub _uri_escape {
########################################################################
  my ($str) = @_;

  $str =~ s/([^A-Za-z0-9\-_.~])/sprintf '%%%02X', ord($1)/xsmeg;

  return $str;
}

########################################################################
sub is_refreshable {
########################################################################
  return 1;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  my $credentials = $self->_get_credentials(
    region            => $self->get_region,
    role_arn          => $self->get_role_arn,
    role_session_name => $self->get_role_session_name,
    token_file        => $self->get_token_file,
    user_agent        => $self->get_user_agent,
  );

  $self->set_aws_access_key_id( $credentials->{AccessKeyId} );

  $self->set_aws_secret_access_key( $credentials->{SecretAccessKey} );

  $self->set_token( $credentials->{SessionToken} );

  $self->set_expiration( $credentials->{Expiration} );

  $self->set_last_refreshed(time);

  return $self;
}

1;
