package Amazon::Credentials::Provider::Env;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

use Carp;

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  my $access_key = $ENV{AWS_ACCESS_KEY_ID};
  my $secret_key = $ENV{AWS_SECRET_ACCESS_KEY};

  return
    if !$access_key && !$secret_key;

  croak 'AWS_ACCESS_KEY_ID is set but AWS_SECRET_ACCESS_KEY is not set'
    if $access_key && !$secret_key;

  croak 'AWS_SECRET_ACCESS_KEY is set but AWS_ACCESS_KEY_ID is not set'
    if !$access_key && $secret_key;

  $options->{aws_access_key_id}     = $access_key;
  $options->{aws_secret_access_key} = $secret_key;
  $options->{region}                = $ENV{AWS_REGION} // $ENV{AWS_DEFAULT_REGION};
  $options->{source}                = 'env';
  $options->{token}                 = $ENV{AWS_SESSION_TOKEN} // $ENV{AWS_SECURITY_TOKEN};

  return $class->SUPER::new($options);
}

1;
