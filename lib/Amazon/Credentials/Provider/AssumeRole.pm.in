package Amazon::Credentials::Provider::AssumeRole;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    duration_seconds
    external_id
    mfa_serial
    mfa_token
    role_arn
    role_session_name
    source_provider
    user_agent
  )
);

use Amazon::Credentials::HTTP::UserAgent;
use Amazon::Signature4::Lite;
use Carp;
use English qw(-no_match_vars);
use HTTP::Request;
use URI::Escape qw(uri_escape_utf8);

use constant { ## no critic
  DEFAULT_REGION       => 'us-east-1',
  DEFAULT_SESSION_NAME => 'amazon-credentials-session',
  STS_VERSION          => '2011-06-15',
};

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options
    = ref $args[0]
    ? { %{ $args[0] } }
    : {@args};

  my $role_arn = $options->{role_arn};

  return
    if !defined $role_arn || !length $role_arn;

  my $source_provider = $options->{source_provider};

  croak 'source_provider is required for AssumeRole'
    if !$source_provider || !ref $source_provider;

  my $region = $options->{region} // $source_provider->get_region // $ENV{AWS_REGION} // $ENV{AWS_DEFAULT_REGION}
    // DEFAULT_REGION;

  my $role_session_name = $options->{role_session_name} // DEFAULT_SESSION_NAME;

  my $ua = $options->{user_agent}
    || Amazon::Credentials::HTTP::UserAgent->new;

  my $credentials = $class->_assume_role(
    duration_seconds  => $options->{duration_seconds},
    external_id       => $options->{external_id},
    mfa_serial        => $options->{mfa_serial},
    mfa_token         => $options->{mfa_token},
    region            => $region,
    role_arn          => $role_arn,
    role_session_name => $role_session_name,
    source_provider   => $source_provider,
    user_agent        => $ua,
  );

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{AccessKeyId},
    aws_secret_access_key => $credentials->{SecretAccessKey},
    expiration            => $credentials->{Expiration},
    region                => $region,
    source                => 'assume_role',
    token                 => $credentials->{SessionToken},
  );

  $self->set_duration_seconds( $options->{duration_seconds} );

  $self->set_external_id( $options->{external_id} );

  $self->set_mfa_serial( $options->{mfa_serial} );

  $self->set_role_arn($role_arn);

  $self->set_role_session_name($role_session_name);

  $self->set_source_provider($source_provider);

  $self->set_user_agent($ua);

  return $self;
}

########################################################################
sub _assume_role {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my %params = (
    Action          => 'AssumeRole',
    RoleArn         => $options->{role_arn},
    RoleSessionName => $options->{role_session_name},
    Version         => STS_VERSION,
  );

  if ( defined $options->{mfa_serial} ) {
    $params{SerialNumber} = $options->{mfa_serial};
    $params{TokenCode}    = $options->{mfa_token};
  }

  if ( defined $options->{external_id}
    && length $options->{external_id} ) {

    $params{ExternalId} = $options->{external_id};
  }

  if ( defined $options->{duration_seconds} ) {
    $params{DurationSeconds} = $options->{duration_seconds};
  }

  my $content = join q{&}, map { uri_escape_utf8($_) . q{=} . uri_escape_utf8( $params{$_} ) }
    sort keys %params;

  my $region = $options->{region};

  my $url = sprintf 'https://sts.%s.amazonaws.com/', $region;

  my %headers = ( 'content-type' => 'application/x-www-form-urlencoded; charset=utf-8', );

  my $source = $options->{source_provider};

  my $signer = Amazon::Signature4::Lite->new(
    access_key    => $source->get_aws_access_key_id,
    secret_key    => $source->get_aws_secret_access_key,
    session_token => $source->get_token,
    region        => $region,
    service       => 'sts',
  );

  my $signed_headers = $signer->sign(
    headers           => \%headers,
    method            => 'POST',
    payload           => \$content,
    url               => $url,
    add_sha256_header => 0,
  );

  my $req = HTTP::Request->new( POST => $url );

  foreach my $header ( keys %{$signed_headers} ) {
    $req->header( $header, $signed_headers->{$header} );
  }

  $req->content($content);

  my $rsp = $options->{user_agent}->request($req);

  croak 'no response from AssumeRole'
    if !$rsp;

  if ( !$rsp->is_success ) {
    my $detail = _extract_sts_error( $rsp->content );

    croak sprintf
      'AssumeRole failed: %s%s',
      $rsp->status_line,
      $detail;
  }

  my $xml = $rsp->content;

  my $credentials = {
    AccessKeyId => _xml_element( $xml, 'AccessKeyId' ),

    SecretAccessKey => _xml_element( $xml, 'SecretAccessKey' ),

    SessionToken => _xml_element( $xml, 'SessionToken' ),

    Expiration => _xml_element( $xml, 'Expiration' ),
  };

  croak 'AssumeRole returned no AccessKeyId'
    if !$credentials->{AccessKeyId};

  croak 'AssumeRole returned no SecretAccessKey'
    if !$credentials->{SecretAccessKey};

  return $credentials;
}

########################################################################
sub _xml_element {
########################################################################
  my ( $xml, $tag ) = @_;

  if ( $xml =~ m{<$tag>([^<]+)</$tag>}xsm ) {
    return $1;
  }

  return undef; ## no critic
}

########################################################################
sub _extract_sts_error {
########################################################################
  my ($xml) = @_;

  return q{}
    if !defined $xml || !length $xml;

  my $code = _xml_element( $xml, 'Code' ) // q{};

  my $message = _xml_element( $xml, 'Message' ) // q{};

  return q{}
    if !$code && !$message;

  return " - $code: $message";
}

########################################################################
sub is_refreshable {
########################################################################
  return 1;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  my $source_provider = $self->get_source_provider;

  if ( $source_provider->is_refreshable ) {
    $source_provider->refresh_credentials;
  }

  my $mfa_token;

  if ( defined $self->get_mfa_serial ) {
    croak 'MFA refresh requires AMAZON_CREDENTIALS_MFA_TOKEN'
      if !defined $ENV{AMAZON_CREDENTIALS_MFA_TOKEN};

    $mfa_token = $ENV{AMAZON_CREDENTIALS_MFA_TOKEN};
  }

  my $credentials = $self->_assume_role(
    duration_seconds  => $self->get_duration_seconds,
    external_id       => $self->get_external_id,
    mfa_serial        => $self->get_mfa_serial,
    mfa_token         => $mfa_token,
    region            => $self->get_region,
    role_arn          => $self->get_role_arn,
    role_session_name => $self->get_role_session_name,
    source_provider   => $source_provider,
    user_agent        => $self->get_user_agent,
  );

  $self->set_aws_access_key_id( $credentials->{AccessKeyId} );

  $self->set_aws_secret_access_key( $credentials->{SecretAccessKey} );

  $self->set_token( $credentials->{SessionToken} );

  $self->set_expiration( $credentials->{Expiration} );

  $self->set_last_refreshed(time);

  return $self;
}

1;
