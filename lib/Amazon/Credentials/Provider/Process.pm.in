package Amazon::Credentials::Provider::Process;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    process
    profile
  )
);

use Carp;
use English qw(-no_match_vars);
use JSON;
use Role::Tiny::With;

with 'Amazon::Credentials::Role::File';

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  my $profile = $options->{profile} || 'default';

  my $config = $class->_get_profile($profile);

  return
    if !$config;

  my $process = $config->{credential_process};

  return
    if !$process;

  my $credentials = $class->_run_process($process);

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{AccessKeyId},
    aws_secret_access_key => $credentials->{SecretAccessKey},
    expiration            => $credentials->{Expiration},
    region                => $credentials->{Region} || $config->{region},
    source                => 'process',
    token                 => $credentials->{SessionToken},
  );

  $self->set_process($process);
  $self->set_profile($profile);

  return $self;
}

########################################################################
sub _run_process {
########################################################################
  my ( $self, $process ) = @_;

  my $credentials = eval {
    open my $fh, q{-|}, $process
      or croak "could not open pipe to $process\n$OS_ERROR";

    local $RS = undef;

    my $credentials_str = <$fh>;

    close $fh
      or croak "could not close filehandle on $process\n";

    return decode_json($credentials_str);
  };

  croak "could not get credentials from process\n$EVAL_ERROR"
    if $EVAL_ERROR;

  croak 'credential process returned no credentials'
    if !ref $credentials;

  croak 'credential process returned no AccessKeyId'
    if !$credentials->{AccessKeyId};

  croak 'credential process returned no SecretAccessKey'
    if !$credentials->{SecretAccessKey};

  return $credentials;
}

########################################################################
sub is_refreshable {
########################################################################
  return 1;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  my $credentials = $self->_run_process( $self->get_process );

  $self->set_aws_access_key_id( $credentials->{AccessKeyId} );
  $self->set_aws_secret_access_key( $credentials->{SecretAccessKey} );
  $self->set_token( $credentials->{SessionToken} );
  $self->set_expiration( $credentials->{Expiration} );

  if ( $credentials->{Region} ) {
    $self->set_region( $credentials->{Region} );
  }

  $self->set_last_refreshed(time);

  return $self;
}

1;
