package Amazon::Credentials::Provider::InstanceRole;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    imdsv2
    imdsv2_token
    metadata_base_url
    role
    user_agent
  )
);

use Amazon::Credentials::HTTP::UserAgent;
use Carp;
use English qw(-no_match_vars);
use HTTP::Request;
use JSON;

use constant { ## no critic
  AWS_IAM_SECURITY_CREDENTIALS_URI => q{latest/meta-data/iam/security-credentials/},
  IMDSv2_DEFAULT_TTL               => 21_600,
  IMDSv2_HEADER                    => q{x-aws-ec2-metadata-token},
  IMDSv2_TTL_HEADER                => q{x-aws-ec2-metadata-token-ttl-seconds},
  IMDSv2_URI                       => q{latest/api/token},
};

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  my $disabled = $ENV{AWS_EC2_METADATA_DISABLED} // q{};

  return
    if $disabled eq 'true';

  my $metadata_base_url = $options->{metadata_base_url} || q{http://169.254.169.254/};

  my $ua = $options->{user_agent} || Amazon::Credentials::HTTP::UserAgent->new;

  my $imdsv2 = $options->{imdsv2};

  $imdsv2 = 'preferred'
    if !defined $imdsv2;

  $imdsv2 = $imdsv2 ? 'required' : 'disabled'
    if $imdsv2 =~ /\A[01]\z/xsm;

  my $imdsv2_token;

  if ( $imdsv2 ne 'disabled' ) {
    my $result = eval {
      $imdsv2_token = $class->_get_imdsv2_token(
        metadata_base_url => $metadata_base_url,
        user_agent        => $ua,
      );

      return 1;
    };

    if ( !$result ) {
      croak $EVAL_ERROR
        if $imdsv2 eq 'required';
    }
  }

  my $role = $class->_get_role_name(
    imdsv2_token      => $imdsv2_token,
    metadata_base_url => $metadata_base_url,
    user_agent        => $ua,
  );

  return
    if !$role;

  my $credentials = $class->_get_role_credentials(
    role              => $role,
    imdsv2_token      => $imdsv2_token,
    metadata_base_url => $metadata_base_url,
    user_agent        => $ua,
  );

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{AccessKeyId},
    aws_secret_access_key => $credentials->{SecretAccessKey},
    expiration            => $credentials->{Expiration},
    source                => 'instance_role',
    token                 => $credentials->{Token},
  );

  $self->set_imdsv2($imdsv2);
  $self->set_imdsv2_token($imdsv2_token);
  $self->set_metadata_base_url($metadata_base_url);
  $self->set_role($role);
  $self->set_user_agent($ua);

  return $self;
}

########################################################################
sub _get_imdsv2_token {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my $url = $options->{metadata_base_url} . IMDSv2_URI;

  my $req = HTTP::Request->new( PUT => $url );

  $req->header( IMDSv2_TTL_HEADER, IMDSv2_DEFAULT_TTL );

  my $rsp = $options->{user_agent}->request($req);

  croak 'no response from IMDSv2 token endpoint'
    if !$rsp;

  croak 'could not retrieve IMDSv2 token'
    if !$rsp->is_success;

  my $token = $rsp->content;

  croak 'IMDSv2 token endpoint returned no token'
    if !defined $token || !length $token;

  return $token;
}

########################################################################
sub _get_role_name {
########################################################################
  my ( $self, @args ) = @_;

  my $options = ref $args[0] ? $args[0] : {@args};

  my $url = $options->{metadata_base_url} . AWS_IAM_SECURITY_CREDENTIALS_URI;

  my $req = HTTP::Request->new( GET => $url );

  if ( $options->{imdsv2_token} ) {
    $req->header( IMDSv2_HEADER, $options->{imdsv2_token} );
  }

  my $rsp = $options->{user_agent}->request($req);

  return
    if !$rsp || !$rsp->is_success;

  my $role = $rsp->content;

  return
    if !defined $role || !length $role;

  chomp $role;

  return $role;
}

########################################################################
sub _get_role_credentials {
########################################################################
  my ( $self, @args ) = @_;

  my $options = ref $args[0] ? $args[0] : {@args};

  my $url = $options->{metadata_base_url} . AWS_IAM_SECURITY_CREDENTIALS_URI . $options->{role};

  my $req = HTTP::Request->new( GET => $url );

  if ( $options->{imdsv2_token} ) {
    $req->header( IMDSv2_HEADER, $options->{imdsv2_token} );
  }

  my $rsp = $options->{user_agent}->request($req);

  croak 'no response from instance role credential endpoint'
    if !$rsp;

  croak sprintf 'instance role credential request failed: %s', $rsp->status_line
    if !$rsp->is_success;

  my $credentials = eval { return decode_json( $rsp->content ); };

  croak 'could not decode instance role credentials'
    if $EVAL_ERROR || !ref $credentials;

  croak 'instance role response contains no AccessKeyId'
    if !$credentials->{AccessKeyId};

  croak 'instance role response contains no SecretAccessKey'
    if !$credentials->{SecretAccessKey};

  return $credentials;
}

########################################################################
sub is_refreshable {
########################################################################
  return 1;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  my $credentials = $self->_get_role_credentials(
    role              => $self->get_role,
    imdsv2_token      => $self->get_imdsv2_token,
    metadata_base_url => $self->get_metadata_base_url,
    user_agent        => $self->get_user_agent,
  );

  $self->set_aws_access_key_id( $credentials->{AccessKeyId} );

  $self->set_aws_secret_access_key( $credentials->{SecretAccessKey} );

  $self->set_token( $credentials->{Token} );

  $self->set_expiration( $credentials->{Expiration} );

  $self->set_last_refreshed(time);

  return $self;
}

1;
