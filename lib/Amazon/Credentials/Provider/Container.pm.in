package Amazon::Credentials::Provider::Container;

use strict;
use warnings;

use 5.010;

use parent qw(Amazon::Credentials::Provider);

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(
  qw(
    authorization_token
    authorization_token_file
    container_type
    credential_uri
    user_agent
  )
);

use Amazon::Credentials::HTTP::UserAgent;
use Amazon::Credentials::Utils qw(choose);
use Carp;
use English qw(-no_match_vars);
use HTTP::Request;
use JSON;

use constant { ## no critic
  AWS_CONTAINER_CREDENTIALS_URL => q{http://169.254.170.2},
};

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  my $relative_uri = $ENV{AWS_CONTAINER_CREDENTIALS_RELATIVE_URI};
  my $full_uri     = $ENV{AWS_CONTAINER_CREDENTIALS_FULL_URI};

  return
    if !$relative_uri && !$full_uri;

  my ( $container_type, $credential_uri ) = choose {
    return ( 'relative', AWS_CONTAINER_CREDENTIALS_URL . $relative_uri ) if $relative_uri;

    return ( 'full', $full_uri ) if $full_uri;
  };

  if ( $container_type eq 'full' ) {
    _validate_full_uri($credential_uri);
  }

  my $ua = $options->{user_agent} || Amazon::Credentials::HTTP::UserAgent->new;

  my $credentials = $class->_get_credentials(
    credential_uri           => $credential_uri,
    authorization_token      => $ENV{AWS_CONTAINER_AUTHORIZATION_TOKEN},
    authorization_token_file => $ENV{AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE},
    user_agent               => $ua,
  );

  my $self = $class->SUPER::new(
    aws_access_key_id     => $credentials->{AccessKeyId},
    aws_secret_access_key => $credentials->{SecretAccessKey},
    expiration            => $credentials->{Expiration},
    source                => 'container',
    token                 => $credentials->{Token},
  );

  $self->set_authorization_token( $ENV{AWS_CONTAINER_AUTHORIZATION_TOKEN} );

  $self->set_authorization_token_file( $ENV{AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE} );

  $self->set_container_type($container_type);
  $self->set_credential_uri($credential_uri);
  $self->set_user_agent($ua);

  return $self;
}

########################################################################
sub _get_credentials {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my $token = _get_authorization_token( $options->{authorization_token}, $options->{authorization_token_file}, );

  my $req = HTTP::Request->new( GET => $options->{credential_uri} );

  $req->header( Accept => '*/*' );

  if ( defined $token && length $token ) {
    $req->header( Authorization => $token );
  }

  my $rsp = $options->{user_agent}->request($req);

  croak 'no response from container credential endpoint'
    if !$rsp;

  croak sprintf 'container credential request failed: %s', $rsp->status_line
    if !$rsp->is_success;

  my $credentials = eval { return decode_json( $rsp->content ); };

  croak "could not decode container credentials\n$EVAL_ERROR"
    if $EVAL_ERROR || !ref $credentials;

  croak 'container credential response contains no AccessKeyId'
    if !$credentials->{AccessKeyId};

  croak 'container credential response contains no SecretAccessKey'
    if !$credentials->{SecretAccessKey};

  return $credentials;
}

########################################################################
sub _get_authorization_token {
########################################################################
  my ( $token, $token_file ) = @_;

  return $token
    if !defined $token_file || !length $token_file;

  open my $fh, '<', $token_file
    or croak "cannot open token file '$token_file': $OS_ERROR";

  {
    local $RS = undef;
    $token = <$fh>;
  }

  close $fh
    or croak "cannot close token file '$token_file': $OS_ERROR";

  chomp $token
    if defined $token;

  return $token;
}

########################################################################
sub _validate_full_uri {
########################################################################
  my ($url) = @_;

  return
    if $url =~ m{
      \A
      (?: https://
        | http://127[.]
        | http://\[::1\]
        | http://169[.]254[.]170[.]23
      )
    }xsm;

  croak 'AWS_CONTAINER_CREDENTIALS_FULL_URI must be https://, ' . 'http://127.x.x.x, http://[::1], or http://169.254.170.23';

  return;
}

########################################################################
sub is_refreshable {
########################################################################
  return 1;
}

########################################################################
sub refresh_credentials {
########################################################################
  my ($self) = @_;

  my $credentials = $self->_get_credentials(
    credential_uri           => $self->get_credential_uri,
    authorization_token      => $self->get_authorization_token,
    authorization_token_file => $self->get_authorization_token_file,
    user_agent               => $self->get_user_agent,
  );

  $self->set_aws_access_key_id( $credentials->{AccessKeyId} );

  $self->set_aws_secret_access_key( $credentials->{SecretAccessKey} );

  $self->set_token( $credentials->{Token} );

  $self->set_expiration( $credentials->{Expiration} );

  $self->set_last_refreshed(time);

  return $self;
}

1;
