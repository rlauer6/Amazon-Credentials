package Amazon::Credentials::HTTP::UserAgent;

use strict;
use warnings;

use HTTP::Tiny;
use Amazon::Credentials::HTTP::Response;

########################################################################
sub new {
########################################################################
  my ( $class, %opts ) = @_;

  return bless { ua => HTTP::Tiny->new(%opts) }, $class;
}

########################################################################
sub request {
########################################################################
  my ( $self, $request ) = @_;

  my %headers;

  $request->headers->scan(
    sub {
      my ( $field, $value ) = @_;

      return if lc $field eq 'host';

      # HTTP::Headers keeps an underscore in a field name only when the name
      # carries a leading ':' sigil (which suppresses its _ -> - translation).
      # That sigil is private to HTTP::Headers and is stripped when it
      # serializes (see HTTP::Headers::as_string). We bypass that serialization
      # and hand names straight to HTTP::Tiny, so we must strip it ourselves --
      # otherwise the ':' reaches HTTP::Tiny, which rejects it as an invalid
      # field-name character (e.g. the x-amz-sso_bearer_token SSO header).
      $field =~ s/^://xsm;

      $headers{$field} = $value;
    }
  );

  my %opts = ( headers => \%headers );

  if ( my $content = $request->content ) {
    $opts{content} = $content;
  }

  my $response = $self->{ua}->request( $request->method, $request->uri->as_string, \%opts );

  return Amazon::Credentials::HTTP::Response->new($response);
}

1;
