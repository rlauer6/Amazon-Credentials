package Amazon::Credentials::Resolver::Profile;

use strict;
use warnings;

use 5.010;

use Amazon::Credentials::Provider::AssumeRole;
use Amazon::Credentials::Provider::Config;
use Amazon::Credentials::Provider::Process;
use Amazon::Credentials::Provider::Container;
use Amazon::Credentials::Provider::Env;
use Amazon::Credentials::Provider::InstanceRole;
use Amazon::Credentials::Provider::WebIdentity;
use Amazon::Credentials::Provider::SSO;

use Carp;
use Role::Tiny::With;

with 'Amazon::Credentials::Role::File';

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my $options = ref $args[0] ? { %{ $args[0] } } : {@args};

  return bless {
    user_agent => $options->{user_agent},
    imdsv2     => $options->{imdsv2},
  }, $class;
}

########################################################################
sub resolve {
########################################################################
  my ( $self, $profile ) = @_;

  $profile ||= 'default';

  return $self->_resolve_profile(
    profile => $profile,
    seen    => {},
  );
}

########################################################################
sub _resolve_profile {
########################################################################
  my ( $self, @args ) = @_;

  my $options = ref $args[0] ? $args[0] : {@args};

  my $profile = $options->{profile};

  my $seen = $options->{seen};

  croak "credential profile cycle detected at '$profile'"
    if $seen->{$profile};

  my %seen = %{$seen};

  $seen{$profile} = 1;

  my $config = $self->_get_profile($profile);

  return
    if !$config || !keys %{$config};

  if ( $config->{web_identity_token_file} ) {
    croak "profile '$profile' has web_identity_token_file but no role_arn"
      if !$config->{role_arn};

    my %provider_options = (
      role_arn   => $config->{role_arn},
      token_file => $config->{web_identity_token_file},
    );

    if ( defined $config->{role_session_name} ) {
      $provider_options{role_session_name} = $config->{role_session_name};
    }

    if ( defined $config->{region} ) {
      $provider_options{region} = $config->{region};
    }

    if ( $self->{user_agent} ) {
      $provider_options{user_agent} = $self->{user_agent};
    }

    return Amazon::Credentials::Provider::WebIdentity->new(%provider_options);
  }

  if ( $config->{role_arn} ) {
    return $self->_resolve_assume_role(
      config  => $config,
      profile => $profile,
      seen    => \%seen,
    );
  }
  if ( $config->{sso_session}
    || $config->{sso_start_url}
    || $config->{sso_account_id}
    || $config->{sso_role_name} ) {
    my %provider_options = ( profile => $profile, );

    if ( $self->{user_agent} ) {
      $provider_options{user_agent} = $self->{user_agent};
    }

    return Amazon::Credentials::Provider::SSO->new(%provider_options);
  }

  if ( $config->{credential_process} ) {
    my %provider_options = ( profile => $profile, );

    if ( $self->{user_agent} ) {
      $provider_options{user_agent} = $self->{user_agent};
    }

    return Amazon::Credentials::Provider::Process->new(%provider_options);
  }

  return Amazon::Credentials::Provider::Config->new( profile => $profile, );
}

########################################################################
sub _resolve_assume_role {
########################################################################
  my ( $self, @args ) = @_;

  my $options = ref $args[0] ? $args[0] : {@args};

  my $config = $options->{config};

  my $profile = $options->{profile};

  my $source_profile = $config->{source_profile};

  my $credential_source = $config->{credential_source};

  croak "profile '$profile' cannot specify both source_profile and credential_source"
    if $source_profile && $credential_source;

  croak "profile '$profile' has role_arn but no credential source"
    if !$source_profile && !$credential_source;

  my $source_provider;

  if ($source_profile) {
    $source_provider = $self->_resolve_profile(
      profile => $source_profile,
      seen    => $options->{seen},
    );

    croak "unable to resolve source_profile '$source_profile' for profile '$profile'"
      if !$source_provider;
  }
  else {
    $source_provider = $self->_resolve_credential_source($credential_source);

    croak "unable to resolve credential_source '$credential_source' for profile '$profile'"
      if !$source_provider;
  }

  my %provider_options = (
    role_arn        => $config->{role_arn},
    source_provider => $source_provider,
  );

  if ( defined $config->{mfa_serial} ) {
    croak "profile '$profile' requires MFA but AMAZON_CREDENTIALS_MFA_TOKEN is not set"
      if !defined $ENV{AMAZON_CREDENTIALS_MFA_TOKEN};

    $provider_options{mfa_serial} = $config->{mfa_serial};
    $provider_options{mfa_token}  = $ENV{AMAZON_CREDENTIALS_MFA_TOKEN};
  }

  if ( defined $config->{role_session_name} ) {
    $provider_options{role_session_name} = $config->{role_session_name};
  }

  if ( defined $config->{external_id} ) {
    $provider_options{external_id} = $config->{external_id};
  }

  if ( defined $config->{duration_seconds} ) {
    $provider_options{duration_seconds} = $config->{duration_seconds};
  }

  if ( defined $config->{region} ) {
    $provider_options{region} = $config->{region};
  }

  if ( $self->{user_agent} ) {
    $provider_options{user_agent} = $self->{user_agent};
  }

  return Amazon::Credentials::Provider::AssumeRole->new(%provider_options);
}

########################################################################
sub _resolve_credential_source {
########################################################################
  my ( $self, $source ) = @_;

  if ( $source eq 'Environment' ) {
    return Amazon::Credentials::Provider::Env->new;
  }
  elsif ( $source eq 'EcsContainer' ) {
    my %options;

    if ( $self->{user_agent} ) {
      $options{user_agent} = $self->{user_agent};
    }

    return Amazon::Credentials::Provider::Container->new(%options);
  }
  elsif ( $source eq 'Ec2InstanceMetadata' ) {
    my %options = ( imdsv2 => $self->{imdsv2}, );

    if ( $self->{user_agent} ) {
      $options{user_agent} = $self->{user_agent};
    }

    return Amazon::Credentials::Provider::InstanceRole->new(%options);
  }

  croak "unsupported credential_source '$source'";
}

1;
