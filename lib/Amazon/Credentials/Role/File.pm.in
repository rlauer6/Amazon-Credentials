package Amazon::Credentials::Role::File;

use strict;
use warnings;

use 5.010;

use Data::Dumper;
use Role::Tiny;
use Amazon::Credentials::Utils qw(choose);

########################################################################
sub _create_config_path {
########################################################################
  my ( $self, $config ) = @_;

  require File::HomeDir;
  File::HomeDir->import('home');

  my $fullpath = home() . q{/} . $config;

  return -e $fullpath ? $fullpath : q{};
}

########################################################################
sub _get_profile_sections {
########################################################################
  my ( $self, $profile ) = @_;

  require Config::Tiny;

  $profile ||= 'default';

  my @sections;

  foreach my $config (qw(.aws/config .aws/credentials)) {
    my $fullpath = $self->_create_config_path($config);

    next
      if !$fullpath;

    my $ini = Config::Tiny->read($fullpath);

    if ( !$ini ) {
      next;
    }

    my $section = choose {

      return $ini->{$profile}
        if $ini->{$profile};

      return $ini->{"profile $profile"}
        if $ini->{"profile $profile"};
    };

    next
      if !$section;

    push @sections,
      {
      config  => $config,
      ini     => $ini,
      section => $section,
      };
  }

  return \@sections;
}

########################################################################
sub _get_profile {
########################################################################
  my ( $self, $profile ) = @_;

  my $sections = $self->_get_profile_sections($profile);

  return
    if !@{$sections};

  my %profile;

  foreach my $entry ( @{$sections} ) {
    foreach my $key ( keys %{ $entry->{section} } ) {
      $profile{$key} = $entry->{section}{$key};
    }
  }

  return \%profile;
}

1;
