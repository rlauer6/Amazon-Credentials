package Amazon::Credentials::Role::SSOCache;

use strict;
use warnings;

use 5.010;

use Role::Tiny;

use Amazon::Credentials::HTTP::UserAgent;
use Carp;
use English qw(-no_match_vars);
use HTTP::Request;
use JSON;
use Time::Local qw(timegm_modern);

use constant { ## no critic
  CACHE_DIR          => '.aws/sso/cache',
  SSO_OIDC_HOSTNAME  => 'oidc.%s.amazonaws.com',
  SSO_OIDC_TOKEN_URI => 'token',
};

########################################################################
sub _sso_cache_key {
########################################################################
  my ( $self, $value ) = @_;

  return
    if !defined $value || !length $value;

  require Digest::SHA;

  return Digest::SHA::sha1_hex($value);
}

########################################################################
sub _get_access_token {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my $home = $options->{home} // $ENV{HOME};

  my $cache_key = $options->{cache_key};

  my $region = $options->{region};

  my $user_agent = $options->{user_agent} // Amazon::Credentials::HTTP::UserAgent->new;

  my $cache_dir = sprintf
    '%s/%s',
    $home,
    CACHE_DIR;

  croak "no $cache_dir found"
    if !-d $cache_dir;

  my @json_files;

  if ( defined $cache_key ) {
    @json_files = ( sprintf '%s/%s.json', $cache_dir, $cache_key );
  }
  else {
    opendir my $dh, $cache_dir
      or croak "could not open $cache_dir: $OS_ERROR";

    @json_files = map { sprintf '%s/%s', $cache_dir, $_ }
      grep {/[.]json\z/xsm} readdir $dh;

    closedir $dh;
  }

  my @candidates;

  foreach my $file (@json_files) {
    open my $fh, '<', $file
      or next;

    my $content;

    {
      local $RS = undef;
      $content = <$fh>;
    }

    close $fh;

    my $json = eval { return decode_json($content); };

    next
      if !ref $json || !$json->{accessToken};

    my $expires_at = $self->_parse_expires_at( $json->{expiresAt} );

    next
      if !defined $expires_at;

    push @candidates,
      {
      data       => $json,
      expires_at => $expires_at,
      file       => $file,
      token      => $json->{accessToken},
      };
  }

  return
    if !@candidates;

  @candidates = reverse sort { $a->{expires_at} <=> $b->{expires_at} } @candidates;

  my $candidate = $candidates[0];

  return $candidate->{token}
    if $candidate->{expires_at} > time;

  return
    if !$region;

  return $self->_refresh_sso_access_token(
    cache_file => $candidate->{file},
    data       => $candidate->{data},
    region     => $candidate->{data}{region} || $region,
    user_agent => $user_agent,
  );
}

########################################################################
sub _refresh_sso_access_token {
########################################################################
  my ( $self, @args ) = @_;

  my $options
    = ref $args[0]
    ? $args[0]
    : {@args};

  my $cache_file = $options->{cache_file};

  my $token = $options->{data};

  my $region = $options->{region};

  my $ua = $options->{user_agent} // Amazon::Credentials::HTTP::UserAgent->new;

  return
    if !ref $token;

  foreach my $key (
    qw(
    clientId
    clientSecret
    refreshToken
    )
  ) {
    return
      if !defined $token->{$key}
      || !length $token->{$key};
  }

  my $registration_expires_at = $self->_parse_expires_at( $token->{registrationExpiresAt} );

  return
    if defined $registration_expires_at
    && $registration_expires_at <= time;

  my $host = sprintf
    SSO_OIDC_HOSTNAME,
    $region;

  my $url = sprintf
    'https://%s/%s',
    $host,
    SSO_OIDC_TOKEN_URI;

  my $content = encode_json(
    { clientId     => $token->{clientId},
      clientSecret => $token->{clientSecret},
      grantType    => 'refresh_token',
      refreshToken => $token->{refreshToken},
    }
  );

  my $req = HTTP::Request->new( POST => $url );

  $req->header( 'Content-Type', 'application/json' );

  $req->content($content);

  my $rsp = $ua->request($req);

  return
    if !$rsp || !$rsp->is_success;

  my $refreshed = eval { return decode_json( $rsp->content ); };

  return
       if !ref $refreshed
    || !$refreshed->{accessToken}
    || !$refreshed->{expiresIn};

  $token->{accessToken} = $refreshed->{accessToken};

  $token->{expiresAt} = $self->_iso8601_utc( time + $refreshed->{expiresIn} );

  if ( $refreshed->{refreshToken} ) {
    $token->{refreshToken} = $refreshed->{refreshToken};
  }

  $self->_write_sso_cache_file( $cache_file, $token );

  return $token->{accessToken};
}

########################################################################
sub _write_sso_cache_file {
########################################################################
  my ( $self, $cache_file, $token ) = @_;

  return
    if !$cache_file || !ref $token;

  my $tmp_file = sprintf
    '%s.%d.tmp',
    $cache_file,
    $PROCESS_ID;

  open my $fh, '>', $tmp_file
    or croak "could not open $tmp_file: $OS_ERROR";

  print {$fh} encode_json($token);

  close $fh
    or croak "could not close $tmp_file: $OS_ERROR";

  if ( my @stat = stat $cache_file ) {
    chmod $stat[2] & oct('7777'), $tmp_file;
  }

  rename $tmp_file, $cache_file
    or croak "could not rename $tmp_file to $cache_file: $OS_ERROR";

  return 1;
}

########################################################################
sub _iso8601_utc {
########################################################################
  my ( $self, $epoch ) = @_;

  my @g = gmtime $epoch;

  return sprintf
    '%04d-%02d-%02dT%02d:%02d:%02dZ',
    $g[5] + 1900,
    $g[4] + 1,
    @g[ 3, 2, 1, 0 ];
}

########################################################################
sub _parse_expires_at {
########################################################################
  my ( $self, $expires_at ) = @_;

  return
    if !defined $expires_at;

  my @time_parts = $expires_at =~ /\A
    (\d{4})-(\d{2})-(\d{2})
    [T[:space:]]
    (\d{2}):(\d{2}):(\d{2})
    (?:[.]\d+)?
    (?:Z|UTC|[+]00:?00)?
    \z/xsm;

  return
    if !@time_parts;

  $time_parts[1] -= 1;

  return scalar eval { timegm_modern( reverse @time_parts ); };
}

1;
